{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist", "src/app/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/[A-Z]*/*", "**/-[A-Z]*/*"],
            "caseSensitive": true,
            "message": "Компонент импортируется только через public api своей папки (index.ts): './ShowCard', а не './ShowCard/ShowCard' или './ShowCard/usePresenter'."
          },
          {
            "group": ["@/model/*/**"],
            "message": "Модель импортируйте через её index.ts: @/model/<name>."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/components", "@/components/**", "@/model", "@/model/**"],
                "message": "shared — инфраструктура без бизнес-смысла: она не зависит от app, components и model."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/model/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/components", "@/components/**"],
                "message": "model не зависит от UI: импортировать можно только shared."
              },
              {
                "group": ["@/model/*/**"],
                "message": "Другую модель импортируйте через её index.ts: @/model/<name>."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**"],
                "message": "Глобальные компоненты не знают о конкретных экранах из app."
              },
              {
                "group": ["**/[A-Z]*/*", "**/-[A-Z]*/*"],
                "caseSensitive": true,
                "message": "Компонент импортируется только через public api своей папки (index.ts)."
              },
              {
                "group": ["@/model/*/**"],
                "message": "Модель импортируйте через её index.ts: @/model/<name>."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/ui/kit/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
